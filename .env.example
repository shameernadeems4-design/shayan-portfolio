# ---------------------------------------------------------------------------
# Shayan Nadeem — Portfolio environment variables
# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.
#
# Everything EXCEPT contact-form email delivery is optional.
# The portfolio (projects, galleries, filters, project pages) is fully static
# and works with no environment variables at all. To have the contact form
# actually email you inquiries, set RESEND_API_KEY (see the bottom of this file).
# ---------------------------------------------------------------------------

# --- Supabase (optional) ---------------------------------------------------
# OPTIONAL backup store for the contact form. Email delivery does NOT depend on
# this — see the "Contact email delivery" section below.
# Create a free project at https://supabase.com, then copy values from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Used to insert contact submissions securely.
# NEVER prefix this with NEXT_PUBLIC_ and never import it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Canonical URL used for sitemap + Open Graph metadata.
# After deploying on Vercel, set this to your deployment URL, e.g.
# https://your-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Contact email delivery (REQUIRED for the form to send) ----------------
# The contact form delivers inquiries by email through Resend (https://resend.com).
# 1. Create a free Resend account.
# 2. Create an API key at https://resend.com/api-keys.
# 3. Paste it below (server-only — never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=

# Inbox that receives contact-form inquiries.
# Defaults to shameernadeem@gmail.com if left empty.
CONTACT_RECIPIENT_EMAIL=shameernadeem@gmail.com

# Verified "from" sender. Optional.
# Leave empty to use Resend's shared test sender (onboarding@resend.dev), which
# can ONLY deliver to the Resend account's own email address. For production,
# verify a domain at https://resend.com/domains and use e.g.
#   Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
